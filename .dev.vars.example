# Rename this file from .dev.vars.example to .dev.vars and paste in your credentials.
# .dev.vars is gitignored — never commit real secrets.

ENVIRONMENT=development

# Theme session cookie
SESSION_SECRET=KEEP_IT_SECRET_KEEP_IT_SAFE

# ── Contact form (production parity with main) ──────────────────────────────
# Resend — https://resend.com/api-keys (must start with re_)
RESEND_API_KEY=re_PASTE_YOUR_KEY

# Mail routing
CONTACT_TO=hello@zrl.dev
CONTACT_FROM=Contact Form <hello@zrl.dev>

# Cloudflare Turnstile
# Dashboard: https://dash.cloudflare.com/?to=/:account/turnstile
# Local always-pass test keys (Cloudflare documented dummies):
#   sitekey  1x00000000000000000000AA
#   secret   1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Comma-separated hostnames accepted from siteverify (no spaces required)
TURNSTILE_HOSTNAMES=localhost,127.0.0.1,zrl.dev,www.zrl.dev

# Optional: extra allowed Origin headers for the contact action
# CONTACT_ALLOWED_ORIGINS=https://my-preview.vercel.app

# Cloudflare KV — production binding name MUST be RateLimitKV
# Namespace: zrl-rate-limits (id c10b44ec4eb442eca5a737baba9881e3)
# Declared in wrangler.toml; also bind in Pages → Settings → Bindings.
# When absent at runtime, contact falls back to per-isolate memory rate limiting.
