{
  "name": "zrl-dev",
  "homepage": "https://zrl.dev",
  "description": "Portfolio of Zachary Ryan Lopez — AI/ML Data Operations Analyst, Austin TX",
  "repository": "https://github.com/zrlopez/zrl.dev.git",
  "author": "Zachary Ryan Lopez",
  "packageManager": "npm@10.9.8",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "pages:build": "CF_PAGES=1 remix vite:build",
    "dev": "node ./scripts/dev.cjs && remix vite:dev",
    "start": "wrangler pages dev ./build/client",
    "postinstall": "node ./scripts/draco.cjs",
    "deploy": "npm run build && wrangler pages deploy ./build/client --project-name portfolio",
    "dev:storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "deploy:storybook": "wrangler pages deploy ./storybook-static --project-name portfolio-storybook --branch main",
    "lint": "eslint \"app/**/*.{js,jsx,ts,tsx}\" --ignore-pattern \"**/*.stories.*\" --max-warnings 0",
    "type-check": "tsc --noEmit",
    "audit": "npm audit --audit-level=high",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@mdx-js/react": "^3.0.1",
    "@remix-run/cloudflare": "^2.17.5",
    "@remix-run/cloudflare-pages": "^2.17.5",
